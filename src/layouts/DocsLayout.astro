---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Sidebar from '../components/layout/Sidebar.astro';
import TableOfContents from '../components/layout/TableOfContents.astro';
import SearchPalette from '../components/layout/SearchPalette.astro';
import DocFooter from '../components/layout/DocFooter.astro';
import Icon from '../components/ui/Icon.astro';
import * as mdxComponents from '../components/content';
import { site } from '../../site.config';
import { DEFAULT_LOCALE, localizedPath, useTranslations, type Locale } from '../i18n';
import { accentFor, getProject, localised } from '../config/projects';
import { localesForPage, neighboursOf, projectSummaries, searchIndex, sidebarFor, sourcePathFor, type DocPage } from '../lib/docs';

interface Props {
  page: DocPage;
  Content: any;
  headings: MarkdownHeading[];
}

const { page, Content, headings } = Astro.props;
const locale = page.locale as Locale;
const pathname = Astro.url.pathname;
const t = useTranslations(locale);
const project = getProject(page.projectId);

if (!project) throw new Error(`Unknown project "${page.projectId}" for ${page.entry.id}`);

const groups = await sidebarFor(locale, page.projectId, page.href);
const summaries = await projectSummaries(locale);
const neighbours = await neighboursOf(page);
const pages = await searchIndex(locale, (id) => {
  const config = getProject(id);
  return config ? localised(config.name, locale, DEFAULT_LOCALE) : id;
});
const projectName = localised(project.name, locale, DEFAULT_LOCALE);
const title = `${page.title} · ${site.title}/${site.titleAccent}`;
const accent = accentFor(project);
const sourcePath = sourcePathFor(page.entry.id);
const alternates = await localesForPage(page.projectId, page.slug);
const tocHeadings = page.entry.data.tableOfContents ? headings : [];
---

<BaseLayout {title} description={page.description} {locale} {pathname} {alternates}>
  <Header {locale} {pathname} {t} docs />
  <div class="mx-auto flex max-w-[1440px]">
    <Sidebar {project} {groups} {summaries} {locale} {t} />
    <main id="main-content" class="min-w-0 flex-1 px-5 py-10 sm:px-10 lg:px-14">
      <div class="mx-auto max-w-[46rem]">
        <nav class="animate-fade-up mb-5 flex items-center gap-2 text-[13px]" aria-label="Breadcrumb">
          <a href={localizedPath(locale)} class="text-zinc-400 transition hover:text-zinc-900 dark:hover:text-white">{t('nav.home')}</a>
          <Icon name="chevron-right" class="h-3 w-3 text-zinc-300 dark:text-zinc-700" />
          <span class="text-zinc-400">{projectName}</span>
          <Icon name="chevron-right" class="h-3 w-3 text-zinc-300 dark:text-zinc-700" />
          <span class="truncate font-medium text-zinc-700 dark:text-zinc-200" aria-current="page">{page.title}</span>
        </nav>
        <header class="animate-fade-up [animation-delay:.05s]">
          <span class:list={['inline-flex rounded-full bg-violet-500/10 px-3 py-1 text-[11px] font-bold uppercase tracking-wider ring-1 ring-inset', accent.text, accent.ring]}>{page.entry.data.eyebrow ?? page.category}</span>
          <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-[2.6rem] sm:leading-[1.15] dark:text-white">{page.title}</h1>
          {page.description && <p class="mt-4 text-[17px] leading-relaxed text-zinc-500 dark:text-zinc-400">{page.description}</p>}
        </header>
        <article class="docs-prose mt-10 animate-fade-up [animation-delay:.1s]">
          <Content components={mdxComponents} />
        </article>
        <DocFooter prev={neighbours.prev} next={neighbours.next} {sourcePath} entryId={page.entry.id} {locale} {t} />
      </div>
    </main>
    <TableOfContents headings={tocHeadings} {t} />
  </div>
  <SearchPalette {pages} {t} />
</BaseLayout>
