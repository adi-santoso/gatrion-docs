---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import SearchPalette from '../components/layout/SearchPalette.astro';
import { DEFAULT_LOCALE, useTranslations, type Locale } from '../i18n';
import { localised, getProject } from '../config/projects';
import { searchIndex } from '../lib/docs';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
}

const { title, description, locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale } = Astro.props;
const pathname = Astro.url.pathname;
const t = useTranslations(locale);
const pages = await searchIndex(locale, (id) => {
  const project = getProject(id);
  return project ? localised(project.name, locale, DEFAULT_LOCALE) : id;
});
---

<BaseLayout {title} {description} {locale} {pathname}>
  <div class="pointer-events-none fixed inset-0 overflow-hidden">
    <div class="glow-orb left-1/2 top-[-180px] h-[420px] w-[720px] -translate-x-1/2 bg-violet-500/20 dark:bg-violet-600/20"></div>
  </div>
  <div class="bg-grid pointer-events-none fixed inset-0"></div>
  <Header {locale} {pathname} {t} />
  <main id="main-content" class="relative">
    <slot />
  </main>
  <SearchPalette {pages} {t} />
</BaseLayout>
