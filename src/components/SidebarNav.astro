---
import { projects, projectColors, getProjectByName } from '../config/projects';

interface MenuItem {
  label: string;
  href: string;
  badge?: { text: string; color: string };
}

interface MenuSection {
  title: string;
  items: MenuItem[];
}

interface Props {
  project: string;
  sections: MenuSection[];
  currentPath: string;
}

const { project, sections, currentPath } = Astro.props;

const isActive = (href: string) => {
  if (href === currentPath) return true;
  if (href.startsWith('#')) return false;
  return currentPath.startsWith(href);
};

const currentProject = getProjectByName(project);
const projectColor = currentProject ? projectColors[currentProject.color as keyof typeof projectColors] : projectColors.violet;
---

<div class="relative border-b border-zinc-200/60 p-4 dark:border-white/[.06]">
  <div class="mb-3 flex items-center justify-between lg:hidden">
    <span class="text-sm font-bold text-zinc-900 dark:text-white">Menu</span>
    <button id="closeBtn" class="flex h-8 w-8 items-center justify-center rounded-full text-zinc-500 hover:bg-zinc-100 dark:hover:bg-white/[.06]" aria-label="Tutup">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>
  
  <button id="switcherBtn" class="flex w-full items-center gap-3 rounded-xl border border-zinc-200 bg-white p-3 text-left shadow-sm transition hover:border-violet-300 dark:border-white/[.08] dark:bg-white/[.03] dark:hover:border-violet-500/40">
    <span class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br ${projectColor.gradient} ${projectColor.text} ring-1 ring-inset ${projectColor.ring}`}>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>
    </span>
    <span class="min-w-0 flex-1">
      <span class="block truncate text-sm font-bold text-zinc-900 dark:text-white">{project}</span>
      <span class="block font-mono text-[11px] text-zinc-400">{currentProject?.version || 'v1.0.0'} · {currentProject?.status === 'stable' ? 'Stabil' : currentProject?.status === 'beta' ? 'Beta' : 'Draft'}</span>
    </span>
    <svg class="h-4 w-4 shrink-0 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 9l4-4 4 4m0 6l-4 4-4-4"/></svg>
  </button>

  <div id="switcherMenu" class="animate-scale-in absolute left-4 right-4 top-full z-10 mt-2 hidden overflow-hidden rounded-xl border border-zinc-200 bg-white p-1.5 shadow-xl dark:border-white/[.1] dark:bg-[#141416]">
    <p class="px-3 pb-1 pt-2 text-[10px] font-bold uppercase tracking-widest text-zinc-400">Ganti Project</p>
    {projects.map((proj) => {
      const isCurrentProject = proj.name === project;
      const color = projectColors[proj.color as keyof typeof projectColors];
      return (
        <a 
          href={proj.firstDocPath} 
          class={`flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm ${
            isCurrentProject 
              ? 'bg-violet-500/10 font-semibold text-violet-600 dark:text-violet-300' 
              : 'text-zinc-600 transition hover:bg-zinc-50 dark:text-zinc-300 dark:hover:bg-white/[.05]'
          }`}
        >
          <span class={`h-1.5 w-1.5 rounded-full ${color.dot}`}></span>
          {proj.name}
          {isCurrentProject && (
            <svg class="ml-auto h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
          )}
        </a>
      );
    })}
    <div class="mx-1.5 my-1 border-t border-zinc-100 dark:border-white/[.06]"></div>
    <a href="/" class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm text-zinc-500 transition hover:bg-zinc-50 dark:hover:bg-white/[.05]">
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1h3a1 1 0 001-1V10"/></svg>
      Kembali ke Hub
    </a>
  </div>
</div>

<nav class="flex-1 space-y-6 overflow-y-auto p-4 text-[13.5px]">
  {sections.map((section) => (
    <div>
      <p class="mb-1.5 px-3 text-[10px] font-bold uppercase tracking-widest text-zinc-400 dark:text-zinc-600">{section.title}</p>
      <ul class="space-y-px">
        {section.items.map((item) => {
          const active = isActive(item.href);
          return (
            <li>
              <a 
                href={item.href} 
                class={`flex items-center ${item.badge ? 'justify-between' : 'gap-2'} rounded-lg px-3 py-[7px] transition ${
                  active 
                    ? 'bg-violet-500/10 font-semibold text-violet-600 dark:text-violet-300' 
                    : 'text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-white/[.05] dark:hover:text-white'
                }`}
              >
                {active && <span class="h-1 w-1 rounded-full bg-violet-500"></span>}
                <span class="flex-1">{item.label}</span>
                {item.badge && (
                  <span class={`rounded-md px-1.5 py-px font-mono text-[10px] font-bold ${item.badge.color}`}>
                    {item.badge.text}
                  </span>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('switcherBtn');
    const menu = document.getElementById('switcherMenu');
    if (btn && menu) {
      btn.addEventListener('click', (e) => { e.stopPropagation(); menu.classList.toggle('hidden'); });
      document.addEventListener('click', (e) => { if (!menu.contains(e.target as Node)) menu.classList.add('hidden'); });
    }
  });
</script>
