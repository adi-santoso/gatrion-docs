---
interface Props {
  category: string;
  title: string;
  description: string;
}
const { category, title, description } = Astro.props;
---

<div class="animate-fade-up [animation-delay:.05s]">
  <span class="inline-flex items-center gap-1.5 rounded-full bg-violet-500/10 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-violet-500 ring-1 ring-inset ring-violet-500/20">
    {category}
  </span>
  <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-[2.6rem] sm:leading-[1.15] dark:text-white">
    {title}
  </h1>
  <p class="mt-4 text-[17px] leading-relaxed text-zinc-500 dark:text-zinc-400">
    {description}
  </p>
</div>
