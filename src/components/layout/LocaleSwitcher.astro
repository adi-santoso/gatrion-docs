---
import Icon from '../ui/Icon.astro';
import { LOCALES, localeNames, switchLocalePath, type Locale, type TranslateFn } from '../../i18n';

interface Props {
  locale: Locale;
  pathname: string;
  t: TranslateFn;
}

const { locale, pathname, t } = Astro.props;
---

{LOCALES.length > 1 && (
  <div class="relative" data-locale-switcher>
    <button type="button" data-locale-button class="flex h-9 items-center gap-1.5 rounded-full px-2.5 text-xs font-semibold uppercase text-zinc-500 transition hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-white/[0.06] dark:hover:text-white" aria-label={t('locale.switch')} aria-expanded="false">
      <Icon name="globe" class="h-4 w-4" />
      {locale}
    </button>
    <div data-locale-menu class="absolute right-0 top-full z-50 mt-2 hidden min-w-44 rounded-xl border border-zinc-200 bg-white p-1.5 shadow-xl dark:border-white/[0.1] dark:bg-[#141416]">
      {LOCALES.map((item) => (
        <a href={switchLocalePath(pathname, item)} lang={item} class:list={['flex items-center gap-2 rounded-lg px-3 py-2 text-sm transition', item === locale ? 'bg-violet-500/10 font-semibold text-violet-600 dark:text-violet-300' : 'text-zinc-600 hover:bg-zinc-50 dark:text-zinc-300 dark:hover:bg-white/[0.05]']}>
          <span class="w-5 font-mono text-[10px] uppercase text-zinc-400">{item}</span>
          {localeNames[item]}
          {item === locale && <Icon name="check" class="ml-auto h-3.5 w-3.5" width={2.5} />}
        </a>
      ))}
    </div>
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-locale-switcher]').forEach((root) => {
    if (root.dataset.ready) return;
    root.dataset.ready = 'true';
    const button = root.querySelector<HTMLButtonElement>('[data-locale-button]');
    const menu = root.querySelector<HTMLElement>('[data-locale-menu]');
    const close = () => { menu?.classList.add('hidden'); button?.setAttribute('aria-expanded', 'false'); };
    button?.addEventListener('click', (event) => {
      event.stopPropagation();
      menu?.classList.toggle('hidden');
      button.setAttribute('aria-expanded', String(!menu?.classList.contains('hidden')));
    });
    document.addEventListener('click', (event) => { if (!root.contains(event.target as Node)) close(); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') close(); });
  });
</script>
