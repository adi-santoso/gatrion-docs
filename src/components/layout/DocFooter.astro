---
import { site } from '../../../site.config';
import Icon from '../ui/Icon.astro';
import type { DocPage } from '../../lib/docs';
import type { TranslateFn } from '../../i18n';

interface Props { prev: DocPage | null; next: DocPage | null; sourcePath: string; t: TranslateFn }
const { prev, next, sourcePath, t } = Astro.props;
const editHref = site.links.editBase ? `${site.links.editBase}${sourcePath}` : null;
---

<footer class="mt-14 border-t border-zinc-200 pt-6 dark:border-white/[0.06]">
  <nav class="grid gap-3 sm:grid-cols-2" aria-label="Page navigation">
    {prev ? (
      <a href={prev.href} class="group rounded-xl border border-zinc-200 p-4 transition hover:border-violet-300 dark:border-white/[0.08] dark:hover:border-violet-500/35">
        <span class="flex items-center gap-1 text-[11px] font-medium uppercase tracking-wide text-zinc-400"><Icon name="chevron-left" class="h-3 w-3" />{t('page.previous')}</span>
        <span class="mt-1 block text-sm font-semibold text-zinc-800 group-hover:text-violet-600 dark:text-zinc-200 dark:group-hover:text-violet-400">{prev.sidebarLabel}</span>
      </a>
    ) : <span />}
    {next ? (
      <a href={next.href} class="group rounded-xl border border-zinc-200 p-4 text-right transition hover:border-violet-300 dark:border-white/[0.08] dark:hover:border-violet-500/35">
        <span class="flex items-center justify-end gap-1 text-[11px] font-medium uppercase tracking-wide text-zinc-400">{t('page.next')}<Icon name="chevron-right" class="h-3 w-3" /></span>
        <span class="mt-1 block text-sm font-semibold text-zinc-800 group-hover:text-violet-600 dark:text-zinc-200 dark:group-hover:text-violet-400">{next.sidebarLabel}</span>
      </a>
    ) : <span />}
  </nav>
  <div class="mt-8 flex items-center justify-between text-xs text-zinc-400">
    <span>© {new Date().getFullYear()} {site.copyright}</span>
    {editHref && <a href={editHref} target="_blank" rel="noreferrer" class="flex items-center gap-1.5 transition hover:text-violet-500"><Icon name="pencil" class="h-3.5 w-3.5" />{t('page.editThisPage')}</a>}
  </div>
</footer>
