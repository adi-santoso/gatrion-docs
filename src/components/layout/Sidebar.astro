---
import type { SidebarGroup, ProjectSummary } from '../../lib/docs';
import type { ProjectConfig } from '../../config/projects';
import type { Locale, TranslateFn } from '../../i18n';
import SidebarNode from './SidebarNode.astro';
import ProjectSwitcher from './ProjectSwitcher.astro';

interface Props {
  project: ProjectConfig;
  groups: SidebarGroup[];
  summaries: ProjectSummary[];
  locale: Locale;
  t: TranslateFn;
}

const { project, groups, summaries, locale, t } = Astro.props;
const badgeStyles = {
  neutral: 'bg-zinc-500/10 text-zinc-500',
  success: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400',
  info: 'bg-sky-500/10 text-sky-600 dark:text-sky-400',
  warning: 'bg-amber-500/10 text-amber-600 dark:text-amber-400',
  danger: 'bg-rose-500/10 text-rose-600 dark:text-rose-400',
};
---

<div data-sidebar-overlay class="fixed inset-0 z-40 hidden bg-zinc-950/50 backdrop-blur-sm lg:hidden"></div>
<aside data-sidebar class="fixed inset-y-0 left-0 z-50 flex w-[280px] -translate-x-full flex-col border-r border-zinc-200/60 bg-[#fafafa] transition-transform duration-300 lg:sticky lg:top-[60px] lg:z-0 lg:h-[calc(100vh-60px)] lg:translate-x-0 lg:bg-transparent dark:border-white/[0.06] dark:bg-[#09090b] dark:lg:bg-transparent">
  <ProjectSwitcher current={project} {summaries} {locale} {t} />
  <nav class="flex-1 space-y-6 overflow-y-auto p-4 text-[13.5px]" aria-label="Documentation">
    {groups.map((group) => (
      <section>
        <h2 class="mb-1.5 px-3 text-[10px] font-bold uppercase tracking-widest text-zinc-400 dark:text-zinc-600">{group.title}</h2>
        <ul class="space-y-px">
          {group.items.map((item) => (
            <SidebarNode item={item} {badgeStyles} />
          ))}
        </ul>
      </section>
    ))}
  </nav>
</aside>

<script>
  const STORAGE_KEY = 'sidebar:collapsed';
  const collapsed: string[] = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
  const collapsedSet = new Set(collapsed);

  const save = () => localStorage.setItem(STORAGE_KEY, JSON.stringify([...collapsedSet]));

  const wireTrigger = (trigger: HTMLElement) => {
    const container = trigger.parentElement;
    if (!container) return;
    const content = container.querySelector<HTMLElement>(':scope > [data-collapsible-content]');
    if (!content) return;

    const key = trigger.textContent?.trim() ?? '';
    if (collapsedSet.has(key)) {
      content.classList.add('hidden');
      trigger.setAttribute('aria-expanded', 'false');
    }

    trigger.addEventListener('click', () => {
      const hidden = content.classList.toggle('hidden');
      trigger.setAttribute('aria-expanded', String(!hidden));
      if (hidden) collapsedSet.add(key); else collapsedSet.delete(key);
      save();
    });
  };

  document.querySelectorAll<HTMLElement>('[data-collapsible-trigger]').forEach(wireTrigger);
</script>

<script is:inline>
  // Mobile drawer.
  const sidebar = document.querySelector<HTMLElement>('[data-sidebar]');
  const overlay = document.querySelector<HTMLElement>('[data-sidebar-overlay]');
  const close = () => { sidebar?.classList.add('-translate-x-full'); overlay?.classList.add('hidden'); document.body.style.overflow = ''; };
  document.querySelectorAll('[data-menu-open]').forEach((button) => button.addEventListener('click', () => { sidebar?.classList.remove('-translate-x-full'); overlay?.classList.remove('hidden'); document.body.style.overflow = 'hidden'; }));
  document.querySelectorAll('[data-menu-close]').forEach((button) => button.addEventListener('click', close));
  overlay?.addEventListener('click', close);
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') close(); });
</script>
