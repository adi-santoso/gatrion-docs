---
import { site } from '../../../site.config';

interface Props {
  href: string;
  showName?: boolean;
}

const { href, showName = true } = Astro.props;
---

<a href={href} class="flex shrink-0 items-center gap-2.5" aria-label={`${site.title} ${site.titleAccent}`}>
  <span class="relative flex h-7 w-7 items-center justify-center">
    <span class="absolute inset-0 rounded-lg bg-gradient-to-br from-violet-500 to-fuchsia-600 opacity-90"></span>
    <span class="absolute inset-0 rounded-lg bg-gradient-to-br from-violet-500 to-fuchsia-600 opacity-40 blur-md"></span>
    <span class="relative text-sm font-extrabold text-white">{site.logoLetter}</span>
  </span>
  {showName && (
    <span class="hidden text-[15px] font-bold tracking-tight text-zinc-900 sm:block dark:text-white">
      {site.title}<span class="text-zinc-400 dark:text-zinc-600">/</span><span class="bg-gradient-to-r from-violet-500 to-fuchsia-500 bg-clip-text text-transparent">{site.titleAccent}</span>
    </span>
  )}
</a>
