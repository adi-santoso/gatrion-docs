---
/** A single item inside `<Steps>`. */

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="relative pb-8 pl-8 last:pb-0 [counter-increment:step]">
  <span class="absolute -left-[15px] top-0 flex h-7 w-7 items-center justify-center rounded-full border border-violet-500/25 bg-[#fafafa] font-mono text-[11px] font-bold text-violet-600 before:content-[counter(step)] dark:bg-[#09090b] dark:text-violet-400"></span>
  {/* A `span` rather than a heading: the typography plugin styles `h1`–`h4`
      descendants, which would add its own margins here and misalign the title
      with the step marker on the left. It also keeps steps out of the page
      table of contents. */}
  <span class="block text-[15px] font-semibold leading-7 text-zinc-900 dark:text-white">{title}</span>
  <div class="docs-prose prose-sm mt-2 max-w-none prose-p:my-2 prose-p:text-[14px] prose-li:text-[14px] first:*:mt-0 last:*:mb-0">
    <slot />
  </div>
</section>
