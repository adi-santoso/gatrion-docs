---
/** Inline status/method label. */

export type BadgeVariant = 'neutral' | 'success' | 'info' | 'warning' | 'danger' | 'accent';

interface Props {
  variant?: BadgeVariant;
}

const { variant = 'neutral' } = Astro.props;

const styles: Record<BadgeVariant, string> = {
  neutral: 'bg-zinc-500/10 text-zinc-600 ring-zinc-500/15 dark:text-zinc-300',
  success: 'bg-emerald-500/10 text-emerald-600 ring-emerald-500/20 dark:text-emerald-400',
  info: 'bg-sky-500/10 text-sky-600 ring-sky-500/20 dark:text-sky-400',
  warning: 'bg-amber-500/10 text-amber-600 ring-amber-500/20 dark:text-amber-400',
  danger: 'bg-rose-500/10 text-rose-600 ring-rose-500/20 dark:text-rose-400',
  accent: 'bg-violet-500/10 text-violet-600 ring-violet-500/20 dark:text-violet-400',
};
---

<span class:list={['not-prose inline-flex rounded-md px-2 py-0.5 font-mono text-[11px] font-bold ring-1 ring-inset', styles[variant]]}>
  <slot />
</span>
