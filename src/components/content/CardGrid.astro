---
/**
 * CardGrid — responsive container for `<Card>` elements.
 *
 *   <CardGrid>
 *     <Card title="One">…</Card>
 *     <Card title="Two">…</Card>
 *   </CardGrid>
 */

interface Props {
  /** Columns at the `sm` breakpoint and above. Defaults to 2. */
  cols?: 2 | 3;
}

const { cols = 2 } = Astro.props;
---

<div
  class:list={[
    'not-prose my-6 grid gap-3',
    cols === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2',
  ]}
>
  <slot />
</div>
