---
interface Props {
  name: string;
  description: string;
}
const { name, description } = Astro.props;
---

<div class="rounded-xl border border-zinc-200 bg-white/60 p-4 dark:border-white/[.07] dark:bg-white/[.02]">
  <p class="font-mono text-[13px] font-semibold text-zinc-900 dark:text-white">{name}</p>
  <p class="mt-1 text-xs text-zinc-400">{description}</p>
</div>
