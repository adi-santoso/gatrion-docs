---
interface Page { title: string; project: string; url: string; icon: string }
const PAGES = [
  { title: 'Hub — Semua Project', project: 'Home', url: '/', icon: '🏠' },
  { title: 'Core API — Overview', project: 'Core API', url: '/docs/core-api/overview/', icon: '📊' },
  { title: 'Getting Started', project: 'Core API', url: '/docs/core-api/getting-started/', icon: '⚡' },
  { title: 'API Reference', project: 'Core API', url: '/docs/core-api/api-reference/', icon: '🧩' },
  { title: 'Changelog', project: 'Global', url: '/changelog/', icon: '🗒️' },
] as Page[];
---

<div id="palette" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-zinc-950/40 backdrop-blur-sm dark:bg-zinc-950/60" onclick="closePalette()"></div>
  <div class="animate-scale-in relative mx-auto mt-[12vh] w-[92%] max-w-xl overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-2xl dark:border-white/[.1] dark:bg-[#111113]">
    <div class="flex items-center gap-3 border-b border-zinc-100 px-4 dark:border-white/[.06]">
      <svg class="h-4 w-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z"/></svg>
      <input id="paletteInput" type="text" placeholder="Ketik untuk mencari halaman..." class="w-full bg-transparent py-4 text-sm text-zinc-900 placeholder-zinc-400 outline-none dark:text-white" autocomplete="off" />
      <kbd class="rounded-md border border-zinc-200 px-1.5 py-0.5 font-mono text-[10px] text-zinc-400 dark:border-white/[.1]">esc</kbd>
    </div>
    <div id="paletteResults" class="max-h-[320px] overflow-y-auto p-2"></div>
    <div class="flex items-center gap-4 border-t border-zinc-100 px-4 py-2.5 text-[11px] text-zinc-400 dark:border-white/[.06]">
      <span class="flex items-center gap-1"><kbd class="rounded border border-zinc-200 px-1 font-mono dark:border-white/[.1]">↑↓</kbd> navigasi</span>
      <span class="flex items-center gap-1"><kbd class="rounded border border-zinc-200 px-1 font-mono dark:border-white/[.1]">↵</kbd> buka</span>
    </div>
  </div>
</div>

<script>
const PAGES = [
  { title: 'Hub — Semua Project', project: 'Home', url: '/', icon: '🏠' },
  { title: 'Core API — Overview', project: 'Core API', url: '/docs/core-api/overview/', icon: '📊' },
  { title: 'Getting Started', project: 'Core API', url: '/docs/core-api/getting-started/', icon: '⚡' },
  { title: 'API Reference', project: 'Core API', url: '/docs/core-api/api-reference/', icon: '🧩' },
  { title: 'Changelog', project: 'Global', url: '/changelog/', icon: '🗒️' },
];

let selIndex = 0, filtered = [...PAGES];

function renderResults() {
  const container = document.getElementById('paletteResults');
  if (!container) return;
  if (!filtered.length) {
    container.innerHTML = '<p class="px-4 py-8 text-center text-sm text-zinc-400">Tidak ada hasil.</p>';
    return;
  }
  container.innerHTML = filtered.map((p, i) => `
    <a href="${p.url}" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm transition ${i === selIndex ? 'bg-violet-500/10 text-violet-600 dark:text-violet-300' : 'text-zinc-600 hover:bg-zinc-50 dark:text-zinc-300 dark:hover:bg-white/[.04]'}">
      <span class="text-base">${p.icon}</span>
      <span class="flex-1 font-medium">${p.title}</span>
      <span class="rounded-md bg-zinc-100 px-2 py-0.5 text-[10px] font-medium text-zinc-400 dark:bg-white/[.06]">${p.project}</span>
    </a>`).join('');
}

window.openPalette = () => {
  const palette = document.getElementById('palette');
  if (palette) {
    palette.classList.remove('hidden');
    filtered = [...PAGES];
    selIndex = 0;
    renderResults();
    setTimeout(() => { document.getElementById('paletteInput')?.focus(); }, 30);
  }
};

window.closePalette = () => {
  const palette = document.getElementById('palette');
  if (palette) palette.classList.add('hidden');
};

const input = document.getElementById('paletteInput');
if (input) {
  input.addEventListener('input', () => {
    const q = input.value.toLowerCase();
    filtered = PAGES.filter(p => (p.title + ' ' + p.project).toLowerCase().includes(q));
    selIndex = 0;
    renderResults();
  });
}

document.addEventListener('keydown', (e) => {
  if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); openPalette(); }
  const palette = document.getElementById('palette');
  if (!palette || palette.classList.contains('hidden')) return;
  if (e.key === 'Escape') closePalette();
  if (e.key === 'ArrowDown') { e.preventDefault(); selIndex = Math.min(selIndex + 1, filtered.length - 1); renderResults(); }
  if (e.key === 'ArrowUp') { e.preventDefault(); selIndex = Math.max(selIndex - 1, 0); renderResults(); }
  if (e.key === 'Enter' && filtered[selIndex]) window.location.href = filtered[selIndex].url;
});
</script>
