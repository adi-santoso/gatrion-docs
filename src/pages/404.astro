---
import { site } from '../../site.config';
import BaseLayout from '../layouts/BaseLayout.astro';
import Brand from '../components/layout/Brand.astro';
import SearchPalette from '../components/layout/SearchPalette.astro';
import Icon from '../components/ui/Icon.astro';
import { DEFAULT_LOCALE, localizedPath, useTranslations } from '../i18n';
import { getProject, localised } from '../config/projects';
import { searchIndex } from '../lib/docs';

const locale = DEFAULT_LOCALE;
const t = useTranslations(locale);
const pathname = Astro.url.pathname;
const pages = await searchIndex(locale, (id) => {
  const project = getProject(id);
  return project ? localised(project.name, locale, DEFAULT_LOCALE) : id;
});
const title = `${t('notFound.title')} · ${site.title}/${site.titleAccent}`;
---

<BaseLayout {title} description={t('notFound.body')} {locale} {pathname} noindex>
  <main id="main-content" class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-5 text-center">
    <div class="glow-orb left-1/2 top-[-180px] h-[420px] w-[720px] -translate-x-1/2 bg-violet-500/20"></div>
    <div class="bg-grid pointer-events-none absolute inset-0"></div>
    <div class="relative">
      <div class="mb-10 flex justify-center"><Brand href={localizedPath(locale)} /></div>
      <h1 class="bg-gradient-to-b from-zinc-900 to-zinc-400 bg-clip-text text-[7rem] font-extrabold leading-none tracking-tighter text-transparent dark:from-white dark:to-zinc-700">{t('notFound.code')}</h1>
      <h2 class="mt-3 text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-white">{t('notFound.title')}</h2>
      <p class="mx-auto mt-3 max-w-md text-[15px] leading-relaxed text-zinc-500 sm:text-lg dark:text-zinc-400">{t('notFound.body')}</p>
      <div class="mx-auto mt-8 flex max-w-md flex-col gap-3">
        <button type="button" data-search-open class="group flex w-full items-center gap-3 rounded-2xl border border-zinc-200 bg-white/80 px-5 py-3.5 text-left shadow-lg shadow-zinc-200/50 transition hover:border-violet-300 dark:border-white/[0.08] dark:bg-white/[0.04] dark:shadow-black/20 dark:hover:border-violet-500/40">
          <Icon name="search" class="h-5 w-5 text-zinc-400 group-hover:text-violet-500" />
          <span class="flex-1 text-sm text-zinc-400">{t('notFound.searchCta')}</span>
          <kbd class="font-mono text-[11px] text-zinc-400">Ctrl K</kbd>
        </button>
        <div class="flex gap-3">
          <a href={localizedPath(locale)} class="inline-flex flex-1 items-center justify-center rounded-xl bg-zinc-900 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-zinc-800 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-100">{t('notFound.toHub')}</a>
          <button type="button" onclick="history.back()" class="inline-flex flex-1 items-center justify-center rounded-xl border border-zinc-200 bg-white/60 px-5 py-2.5 text-sm font-semibold text-zinc-700 transition hover:border-zinc-300 dark:border-white/[0.1] dark:bg-white/[0.03] dark:text-zinc-200">{t('notFound.goBack')}</button>
        </div>
      </div>
    </div>
  </main>
  <SearchPalette {pages} {t} />
</BaseLayout>
