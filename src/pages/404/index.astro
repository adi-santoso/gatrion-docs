---
export const title = '404 — Halaman tidak ditemukan';
import HubLayout from '../layouts/HubLayout.astro';
/* @ts-ignore */ import CommandPalette from '../../components/CommandPalette.astro';
---

<div class="relative flex min-h-[calc(100vh-60px)] flex-col items-center justify-center px-5 text-center">
  <a href="/" class="animate-fade-up mb-10 flex items-center gap-2.5">
    <span class="relative flex h-8 w-8 items-center justify-center">
      <span class="absolute inset-0 rounded-lg bg-gradient-to-br from-violet-500 to-fuchsia-600 opacity-90"></span>
      <span class="absolute inset-0 rounded-lg bg-gradient-to-br from-violet-500 to-fuchsia-600 blur-md opacity-40"></span>
      <span class="relative text-base font-extrabold text-white">G</span>
    </span>
    <span class="text-lg font-bold tracking-tight text-zinc-900 dark:text-white">gatrion<span class="text-zinc-400 dark:text-zinc-600">/</span><span class="bg-gradient-to-r from-violet-500 to-fuchsia-500 bg-clip-text text-transparent">docs</span></span>
  </a>
  <h1 class="bg-gradient-to-b from-zinc-900 to-zinc-400 bg-clip-text text-[7rem] font-extrabold leading-none tracking-tighter text-transparent dark:from-white dark:to-zinc-700 animate-fade-up">404</h1>
  <h2 class="mt-2 text-2xl font-bold tracking-tight text-zinc-900 [animation-delay:.1s] sm:text-3xl dark:text-white animate-fade-up">Halaman tidak ditemukan</h2>
  <p class="mt-3 max-w-md text-[15px] leading-relaxed text-zinc-500 [animation-delay:.15s] sm:text-lg dark:text-zinc-400 animate-fade-up">
    Sepertinya halaman yang kamu cari sudah dipindahkan atau tidak pernah ada. Coba cari lewat command palette atau kembali ke hub.
  </p>
  <div class="mt-8 flex w-full max-w-md flex-col gap-3 [animation-delay:.2s] animate-fade-up">
    <button onclick="openPalette()" class="group flex w-full items-center gap-3 rounded-2xl border border-zinc-200 bg-white/80 px-5 py-3.5 text-left shadow-lg shadow-zinc-200/50 backdrop-blur transition hover:border-violet-300 dark:border-white/[.08] dark:bg-white/[.04] dark:shadow-black/20 dark:hover:border-violet-500/40">
      <svg class="h-5 w-5 text-zinc-400 transition group-hover:text-violet-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z"/></svg>
      <span class="flex-1 text-[14px] text-zinc-400">Cari halaman...</span>
      <span class="hidden gap-1 sm:flex">
        <kbd class="rounded-md border border-zinc-200 bg-zinc-50 px-2 py-1 font-mono text-[11px] text-zinc-400 dark:border-white/[.08] dark:bg-white/[.04]">Ctrl</kbd>
        <kbd class="rounded-md border border-zinc-200 bg-zinc-50 px-2 py-1 font-mono text-[11px] text-zinc-400 dark:border-white/[.08] dark:bg-white/[.04]">K</kbd>
      </span>
    </button>
    <div class="flex gap-3">
      <a href="/" class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl bg-zinc-900 px-5 py-2.5 text-sm font-semibold text-white shadow-lg transition hover:bg-zinc-800 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-100">Ke Hub</a>
      <button onclick="history.back()" class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl border border-zinc-200 bg-white/60 px-5 py-2.5 text-sm font-semibold text-zinc-700 transition hover:border-zinc-300 dark:border-white/[.1] dark:bg-white/[.03] dark:text-zinc-200 dark:hover:border-white/[.2]">Kembali</button>
    </div>
  </div>
  <div class="mt-10 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[13px] [animation-delay:.25s] animate-fade-up">
    <a href="/" class="text-zinc-400 transition hover:text-violet-500">Semua Project</a>
    <span class="text-zinc-300 dark:text-zinc-700">·</span>
    <a href="/docs/core-api/getting-started/" class="text-zinc-400 transition hover:text-violet-500">Getting Started</a>
    <span class="text-zinc-300 dark:text-zinc-700">·</span>
    <a href="/changelog/" class="text-zinc-400 transition hover:text-violet-500">Changelog</a>
  </div>
</div>

<CommandPalette />
