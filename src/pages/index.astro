---
import HubLayout from '../layouts/HubLayout.astro';
export const title = 'Hub — Gatrion Docs';
---

<HubLayout title={title}>
  <div class="relative mx-auto max-w-6xl px-5 pb-20">
    <!-- Hero -->
    <section class="text-center pt-10 sm:pt-16">
      <div class="animate-fade-up">
        <span class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white/60 px-3.5 py-1 text-xs font-medium text-zinc-500 backdrop-blur dark:border-white/[.08] dark:bg-white/[.03] dark:text-zinc-400">
          <span class="relative flex h-1.5 w-1.5"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span></span>
          4 project terdokumentasi · terakhir update hari ini
        </span>
      </div>
      <h1 class="mx-auto mt-6 max-w-2xl text-4xl font-extrabold leading-[1.1] tracking-tight text-zinc-900 [animation-delay:.08s] sm:text-6xl dark:text-white animate-fade-up">
        Semua dokumentasi,<br />
        <span class="bg-gradient-to-r from-violet-500 via-fuchsia-500 to-cyan-400 bg-clip-text text-transparent">satu tempat.</span>
      </h1>
      <p class="mx-auto mt-5 max-w-lg text-base leading-relaxed text-zinc-500 [animation-delay:.16s] sm:text-lg dark:text-zinc-400 animate-fade-up">
        Knowledge base internal untuk seluruh project Gatrion. Pilih project di bawah, atau tekan <kbd class="rounded-md border border-zinc-300 bg-white px-1.5 py-0.5 font-mono text-xs dark:border-white/[.1] dark:bg-white/[.05]">⌘K</kbd> untuk lompat ke halaman mana pun.
      </p>
      <div class="mx-auto mt-8 max-w-xl [animation-delay:.24s] animate-fade-up">
        <button onclick="openPalette()" class="group flex w-full items-center gap-3 rounded-2xl border border-zinc-200 bg-white/80 px-5 py-4 text-left shadow-lg shadow-zinc-200/50 backdrop-blur transition hover:border-violet-300 dark:border-white/[.08] dark:bg-white/[.04] dark:shadow-black/20 dark:hover:border-violet-500/40">
          <svg class="h-5 w-5 text-zinc-400 transition group-hover:text-violet-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z"/></svg>
          <span class="flex-1 text-[15px] text-zinc-400">Cari docs, panduan, API reference...</span>
          <span class="hidden gap-1 sm:flex">
            <kbd class="rounded-md border border-zinc-200 bg-zinc-50 px-2 py-1 font-mono text-[11px] text-zinc-400 dark:border-white/[.08] dark:bg-white/[.04]">Ctrl</kbd>
            <kbd class="rounded-md border border-zinc-200 bg-zinc-50 px-2 py-1 font-mono text-[11px] text-zinc-400 dark:border-white/[.08] dark:bg-white/[.04]">K</kbd>
          </span>
        </button>
      </div>
    </section>

  <!-- Project cards -->
  <section class="mt-14">
    <div class="mb-6 flex items-end justify-between">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-zinc-900 dark:text-white">Semua Project</h2>
        <p class="mt-0.5 text-sm text-zinc-500">Dikelompokkan berdasarkan kategori</p>
      </div>
      <div class="hidden gap-1.5 sm:flex" id="filterChips">
        <button data-filter="all" class="chip rounded-full bg-zinc-900 px-3.5 py-1.5 text-xs font-medium text-white transition dark:bg-white dark:text-zinc-900">Semua</button>
        <button data-filter="backend" class="chip rounded-full border border-zinc-200 px-3.5 py-1.5 text-xs font-medium text-zinc-500 transition hover:border-zinc-400 dark:border-white/[.08] dark:hover:border-white/[.2]">Backend</button>
        <button data-filter="frontend" class="chip rounded-full border border-zinc-200 px-3.5 py-1.5 text-xs font-medium text-zinc-500 transition hover:border-zinc-400 dark:border-white/[.08] dark:hover:border-white/[.2]">Frontend</button>
        <button data-filter="tooling" class="chip rounded-full border border-zinc-200 px-3.5 py-1.5 text-xs font-medium text-zinc-500 transition hover:border-zinc-400 dark:border-white/[.08] dark:hover:border-white/[.2]">Tooling</button>
      </div>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <a href="/docs/core-api/getting-started/" data-category="backend" class="card-glow group rounded-2xl border border-zinc-200 bg-white/80 p-6 backdrop-blur transition hover:border-violet-300 hover:-translate-y-1 dark:border-white/[.07] dark:bg-white/[.03] dark:hover:border-violet-500/30">
        <div class="flex items-start justify-between">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-violet-500/15 to-fuchsia-500/15 text-violet-500 ring-1 ring-inset ring-violet-500/20">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-semibold text-emerald-600 ring-1 ring-inset ring-emerald-500/20 dark:text-emerald-400"><span class="h-1 w-1 rounded-full bg-emerald-500"></span> Stabil</span>
        </div>
        <h3 class="mt-4 font-bold tracking-tight text-zinc-900 transition group-hover:text-violet-600 dark:text-white dark:group-hover:text-violet-400">Core API</h3>
        <p class="mt-1.5 text-[13px] leading-relaxed text-zinc-500">REST API utama — autentikasi, users, orders, dan payment gateway.</p>
        <div class="mt-5 flex items-center justify-between border-t border-zinc-100 pt-4 text-xs text-zinc-400 dark:border-white/[.05]">
          <span class="font-mono">v2.4.0 · 24 halaman</span>
          <span class="flex items-center gap-1 font-medium text-violet-500 opacity-0 transition group-hover:opacity-100">Buka docs <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></span>
        </div>
      </a>
      <a href="#" data-category="frontend" class="card-glow group rounded-2xl border border-zinc-200 bg-white/80 p-6 backdrop-blur transition hover:border-cyan-300 hover:-translate-y-1 dark:border-white/[.07] dark:bg-white/[.03] dark:hover:border-cyan-500/30">
        <div class="flex items-start justify-between">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-cyan-500/15 to-blue-500/15 text-cyan-500 ring-1 ring-inset ring-cyan-500/20">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-semibold text-emerald-600 ring-1 ring-inset ring-emerald-500/20 dark:text-emerald-400"><span class="h-1 w-1 rounded-full bg-emerald-500"></span> Stabil</span>
        </div>
        <h3 class="mt-4 font-bold tracking-tight text-zinc-900 transition group-hover:text-cyan-600 dark:text-white dark:group-hover:text-cyan-400">Web Dashboard</h3>
        <p class="mt-1.5 text-[13px] leading-relaxed text-zinc-500">Admin panel React — manajemen konten, analitik, dan laporan.</p>
        <div class="mt-5 flex items-center justify-between border-t border-zinc-100 pt-4 text-xs text-zinc-400 dark:border-white/[.05]">
          <span class="font-mono">v1.9.2 · 18 halaman</span>
          <span class="flex items-center gap-1 font-medium text-cyan-500 opacity-0 transition group-hover:opacity-100">Buka docs <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></span>
        </div>
      </a>
      <a href="#" data-category="tooling" class="card-glow group rounded-2xl border border-zinc-200 bg-white/80 p-6 backdrop-blur transition hover:border-orange-300 hover:-translate-y-1 dark:border-white/[.07] dark:bg-white/[.03] dark:hover:border-orange-500/30">
        <div class="flex items-start justify-between">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-orange-500/15 to-amber-500/15 text-orange-500 ring-1 ring-inset ring-orange-500/20">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-zinc-500/10 px-2.5 py-1 text-[11px] font-semibold text-zinc-500 ring-1 ring-inset ring-zinc-500/20">
            <span class="h-1 w-1 rounded-full bg-zinc-400"></span> Draft
          </span>
        </div>
        <h3 class="mt-4 font-bold tracking-tight text-zinc-900 transition group-hover:text-orange-600 dark:text-white dark:group-hover:text-orange-400">CLI Tools</h3>
        <p class="mt-1.5 text-[13px] leading-relaxed text-zinc-500">Command line internal — scaffolding, deploy, dan migrasi database.</p>
        <div class="mt-5 flex items-center justify-between border-t border-zinc-100 pt-4 text-xs text-zinc-400 dark:border-white/[.05]">
          <span class="font-mono">v0.3.0 · 6 halaman</span>
          <span class="flex items-center gap-1 font-medium text-orange-500 opacity-0 transition group-hover:opacity-100">Buka docs <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></span>
        </div>
      </a>
    </div>
  </section>

  <footer class="mt-16 flex flex-col items-center justify-between gap-3 border-t border-zinc-200 pt-8 text-xs text-zinc-400 sm:flex-row dark:border-white/[.06]">
    <p>© 2025 Gatrion — internal documentation hub</p>
    <p class="font-mono">dibuat dengan Astro + Tailwind</p>
  </footer>
  </div>
  <script>
    document.querySelectorAll('.chip').forEach(chip => chip.addEventListener('click', () => {
      document.querySelectorAll('.chip').forEach(c => c.className = 'chip rounded-full border border-zinc-200 px-3.5 py-1.5 text-xs font-medium text-zinc-500 transition hover:border-zinc-400 dark:border-white/[.08] dark:hover:border-white/[.2]');
      chip.className = 'chip rounded-full bg-zinc-900 px-3.5 py-1.5 text-xs font-medium text-white transition dark:bg-white dark:text-zinc-900';
      const f = chip.dataset.filter;
      document.querySelectorAll('#projectGrid > a, # .card-glow').forEach(card => card.style.display = (f === 'all' || card.dataset.category === f) ? '' : 'none');
    }));
  </script>
</HubLayout>
